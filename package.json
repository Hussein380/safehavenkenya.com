{
    "name": "safehaven-monorepo",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=safehaven-frontend",
        "build": "npm run build --workspaces",
        "vercel-build": "npm run build --workspace=safehaven-backend && npm run build --workspace=safehaven-frontend"
    },
    "engines": {
        "node": "20.x"
    },
    "devDependencies": {
        "@types/node": "^25.0.1",
        "@vercel/node": "^5.5.15"
    }
}
